DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marimail

REDIS_URL=redis://localhost:6379
START_WORKERS=true

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 32-byte hex string, e.g. openssl rand -hex 32
ENCRYPTION_KEY=
# Gmail OAuth (server-side, used by Gmail inbox integration — not user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=MariMail <no-reply@mail.maribiz.ai>

INBOUND_EMAIL_DOMAIN=inbound.marimail.local

# ── Payments ─────────────────────────────────────────────────────────────────
# Razorpay is the primary gateway. Leave these blank and checkout is disabled
# (503) — the rest of the app runs normally, which is what you want locally.
# Full setup notes, including the International Payments requirement, are in
# server/.env.example.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe stays configured only for workspaces that subscribed before Razorpay
# became the default; their subscriptions still renew through it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DEMO_ADMIN_EMAIL=your@email.com


APP_URL=http://localhost:3000
API_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:3001