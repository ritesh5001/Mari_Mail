# ─────────────────────────────────────────────
# MariMail — Server (Express on Render)
# Copy to .env for local development.
# All vars marked [Render] must be set in the
# Render service → Environment section.
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=3001
START_WORKERS=true   # set false to disable BullMQ workers (useful for web-only dynos)

# ── URLs ─────────────────────────────────────
APP_URL=http://localhost:3000              # [Render] https://mail.maribiz.ai
API_URL=http://localhost:3001              # [Render] https://<render-service>.onrender.com

# Comma-separated origins allowed for CORS.
ALLOWED_ORIGINS=http://localhost:3000,https://mail.maribiz.ai  # [Render] keep production URL

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marimail  # [Render] use Neon/production URL

# ── Redis (optional — falls back to in-memory) ──
# Required for BullMQ job queues (campaign scheduler, warmup, analytics cron).
# Omit or set to a localhost URL to use the in-memory fallback (dev/testing only).
REDIS_URL=redis://localhost:6379           # [Render] set to Redis Cloud / Upstash URL

# ── Auth secrets ─────────────────────────────
# JWT_ACCESS_SECRET  — signs short-lived access tokens (15 min)
# JWT_REFRESH_SECRET — signs long-lived refresh tokens (7 days)
# ENCRYPTION_KEY     — 64-char hex key used to encrypt stored OAuth tokens
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# ── Email sending (Resend) ───────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=MariMail <no-reply@mail.maribiz.ai>

# ── Google OAuth (Gmail inbox integration) ───
# Same credentials used by the client for user sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (Outlook inbox integration) ──
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=

# ── Stripe (legacy billing) ──────────────────
# Kept for workspaces that subscribed before Razorpay became the default
# checkout — their subscriptions still renew here and the hosted portal is the
# only place they can update a card. New purchases go through Razorpay.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Razorpay (primary payment gateway) ───────────────────────────────────────
#
# All three values are OPTIONAL. With them blank, checkout returns 503 and the
# rest of the app is unaffected — that is the correct local/CI setup, and it is
# why nothing broke when this integration landed.
#
# ─── Step 1 · API keys ───
# Razorpay Dashboard → Account & Settings → API Keys → Generate Key.
# The secret is shown ONCE at generation. Regenerating invalidates the old pair
# immediately, so do it during a quiet window.
#
# Test-mode keys start `rzp_test_`, live keys `rzp_live_`. They are separate
# accounts with separate webhook secrets and separate payment histories; test
# payments never appear in live and vice versa.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# ─── Step 2 · Enable International Payments ───
# REQUIRED. Plans are priced in USD (see packages/utils/src/plans.ts) and
# Razorpay settles in INR, so a stock account rejects every order with
#     international_transaction_not_allowed
# Dashboard → Account & Settings → Payment Methods → International Payments.
# Approval is manual and can take a few business days — start it early.
# The app detects that specific error code and tells the user plainly rather
# than surfacing a raw gateway string.
#
# ─── Step 3 · Webhook ───
# Dashboard → Account & Settings → Webhooks → Add New Webhook.
#
#   URL     https://<your-api-host>/api/razorpay/webhook
#   Events  payment.captured
#           payment.failed
#           order.paid
#
# The "secret" you type into that form is what goes below. It is a value YOU
# choose, and it is NOT the API key secret above — signing a webhook with the
# API secret is rejected (there is a test for exactly that mistake).
#
# Generate one with:  openssl rand -hex 32
#
# LEAVING THIS BLANK REJECTS EVERY WEBHOOK DELIVERY. That is deliberate: an
# unverified webhook endpoint grants paid plans to anyone who can POST to it,
# so it fails closed rather than open. Payments still complete — the browser
# callback provisions them — but a customer who closes the tab mid-payment
# will not get their plan until someone hits /api/razorpay/reconcile.
RAZORPAY_WEBHOOK_SECRET=
#
# ─── Verifying the setup ───
#   1. Signature logic:        pnpm --filter server test:payments
#   2. Test-mode card:         4111 1111 1111 1111, any future expiry, any CVV
#   3. Webhook delivery:       Dashboard → Webhooks → your endpoint → Recent
#                              Deliveries. A 400 there means the secret below
#                              doesn't match the one in the dashboard form.
#   4. Locally, the webhook needs a public URL — expose port 3001 with a
#      tunnel (cloudflared / ngrok) and point the dashboard at that host.

# ── Inbound email (reply tracking) ───────────
INBOUND_EMAIL_DOMAIN=inbound.marimail.local   # [Render] set to your MX-routed subdomain
